# Tappo — variáveis de ambiente. Copie para .env (VPS) ou .env.local (dev) e preencha.

# --- Domínio (VPS) ---
DOMAIN=crm.suaempresa.com
WAHA_DOMAIN=waha.suaempresa.com

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional — Dashboard → Project Settings → Database → Connection string → Session pooler.
# Com isso preenchido, o install.sh/update.sh/backup.sh aplicam o schema e fazem
# backup sozinhos, sem precisar colar SQL manualmente no painel.
SUPABASE_DB_URL=
# Opcional — token pessoal (não é a chave do projeto): supabase.com/dashboard/account/tokens.
# Se preenchido e NEXT_PUBLIC_SUPABASE_URL estiver vazio, o install.sh CRIA o projeto
# Supabase sozinho (nome, chaves e connection string ficam prontos no .env).
SUPABASE_ACCESS_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=https://crm.suaempresa.com

# --- E-mail (Resend) ---
RESEND_API_KEY=
RESEND_FROM=Tappo <no-reply@suaempresa.com>

# --- Agentes de IA ---
ANTHROPIC_API_KEY=
# Gere com: openssl rand -base64 48   (NÃO troque depois de salvar chaves no admin)
AI_KEYS_SECRET=
# Admins "de boot" — entram no /admin mesmo sem ninguém ter promovido ainda.
ADMIN_EMAILS=voce@suaempresa.com
# O ÚNICO e-mail que pode promover/remover outros admins pela tela (seção
# "Administradores" em /admin). Só esta conta decide quem mais vira admin —
# nem outro admin, nem o próprio usuário, conseguem se promover.
SUPER_ADMIN_EMAIL=voce@suaempresa.com

# --- Prospecção (Google Places API — oficial, NÃO é scraping) ---
# Gere em console.cloud.google.com > APIs & Services > ative "Places API (New)".
# Tem cota grátis mensal; acima disso cobra por consulta.
GOOGLE_MAPS_API_KEY=

# --- WAHA (WhatsApp) — o app lê SÓ estas variáveis; a interface não mostra URL nem key ---
# URL pública do WAHA (ou deixe só WAHA_DOMAIN e o app usa https://$WAHA_DOMAIN)
WAHA_BASE_URL=
WAHA_DOMAIN=waha.suaempresa.com
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WAHA_ENGINE=WEBJS
# Assinatura HMAC-SHA512 dos webhooks (recomendado em produção — padrão DeskcommCRM).
# O MESMO valor é usado dos dois lados: o WAHA assina (WHATSAPP_HOOK_HMAC_KEY, já
# amarrado no docker-compose) e o app verifica em tempo constante em /api/v1/waha/*.
# Só ligue a exigência depois de definir o segredo nos DOIS containers:
WAHA_HMAC_SECRET=
WAHA_WEBHOOK_REQUIRE_SIGNATURE=false
